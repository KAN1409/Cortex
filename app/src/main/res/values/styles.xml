<resources>
    <style name="Theme.CortexRebuild" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#080A08</item>
        <item name="android:navigationBarColor">#080A08</item>
        <item name="android:windowBackground">#080A08</item>
        <item name="android:colorAccent">#8FE243</item>
    </style>

    <style name="Theme.CortexCapture" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#8FE243</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
