<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_panel">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/record_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C O R T E X  ·  VOICE"
            android:textColor="#F4F3EF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:letterSpacing="0.10" />

        <TextView
            android:id="@+id/record_widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="READY"
            android:textColor="#A4A3A0"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08" />

        <Chronometer
            android:id="@+id/record_widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#F4F3EF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:visibility="gone" />

        <TextView
            android:id="@+id/record_widget_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Tap to capture a memory"
            android:textColor="#67676A"
            android:textSize="9sp"
            android:fontFamily="sans" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginStart="10dp">

        <ImageView
            android:id="@+id/record_widget_record"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:padding="19dp"
            android:contentDescription="Record"
            android:src="@drawable/ic_cortex_record"
            android:background="@drawable/widget_record_button" />

        <ImageView
            android:id="@+id/record_widget_stop"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:padding="20dp"
            android:contentDescription="Stop recording"
            android:src="@drawable/ic_cortex_stop"
            android:background="@drawable/widget_stop_button"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
